rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLibraryItem(data, userId) {
      return data.userId == userId &&
             data.id is string && data.id.size() > 0 &&
             data.externalId is string &&
             data.source in ['tmdb', 'tvmaze'] &&
             data.title is string && data.title.size() > 0 &&
             data.status in ['WANT_TO_WATCH', 'WATCHING', 'COMPLETED', 'PAUSED', 'DROPPED'] &&
             (!('overview' in data) || data.overview is string) &&
             (!('posterPath' in data) || data.posterPath is string) &&
             (!('backdropPath' in data) || data.backdropPath is string) &&
             (!('genres' in data) || data.genres is list) &&
             (!('totalEpisodes' in data) || data.totalEpisodes is int) &&
             (!('watchedEpisodes' in data) || data.watchedEpisodes is int) &&
             (!('totalSeasons' in data) || data.totalSeasons is int) &&
             (!('isMovie' in data) || data.isMovie is bool) &&
             (!('movieWatched' in data) || data.movieWatched is bool) &&
             (!('userRating' in data) || (data.userRating is number && data.userRating >= 0 && data.userRating <= 10)) &&
             (!('reviewText' in data) || data.reviewText is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidEpisodeProgress(data, userId) {
      return data.userId == userId &&
             data.id is string &&
             data.mediaId is string &&
             data.seasonNumber is int &&
             data.episodeNumber is int &&
             data.watched is bool &&
             (!('title' in data) || data.title is string) &&
             (!('isSpecial' in data) || data.isSpecial is bool) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidReview(data, userId) {
      return data.userId == userId &&
             data.id is string &&
             data.mediaId is string &&
             data.mediaTitle is string &&
             data.rating is number && data.rating >= 0 && data.rating <= 10 &&
             (!('review' in data) || data.review is string) &&
             (!('mediaType' in data) || data.mediaType is string) &&
             (!('posterPath' in data) || data.posterPath is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /library/{mediaId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidLibraryItem(request.resource.data, userId);
        allow delete: if isOwner(userId);

        match /episodes/{episodeId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidEpisodeProgress(request.resource.data, userId);
          allow delete: if isOwner(userId);
        }
      }

      match /reviews/{reviewId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidReview(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
